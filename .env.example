# Priced — copy to .env.local and fill before launch.
# Demo (local/preview): no credentials required — the app runs on an
# in-memory market with a simulated payment provider.
# Production: set the Supabase keys and apply either
# `npx supabase db push` (supabase/migrations/* — canonical) or
# db/schema.sql then db/schema-extended.sql (+ db/migration-quotes-checkout.sql on older DBs)
# on your Supabase Postgres. Keep the two paths in sync.

# ── Database (production) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Payments — Dodo (launch default, production) ──
# Server-only secrets. Never expose to the browser. Never commit real values.
# Test mode: key from the Dodo dashboard (test), DODO_PAYMENTS_MODE=test,
# webhook secret from Developer → Webhooks (test endpoint).
# Live mode: separate key + webhook secret, DODO_PAYMENTS_MODE=live.
# Preview deployments must use TEST credentials only — never live keys.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_MODE=test
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_KEY=
# Optional: billing currency override (default USD). Base currency of the
# PWYW product must be one of USD/INR/GBP/EUR.
# DODO_PAYMENTS_CURRENCY=USD
# Optional: self-hosted / proxy base URL override. Defaults to
# https://test.dodopayments.com (test) or https://live.dodopayments.com (live).
# DODO_PAYMENTS_BASE_URL=

# ── Payments — Stripe (optional adapter, not the launch default) ──
# Kept for fallback experiments only. When both are set, Dodo wins.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Payments — demo only (preview/local) ──
# HMAC secret used to sign the /checkout/mock → /api/webhooks/payments demo
# webhook payloads. Override in env when you want a non-default value.
# Production refuses demo payments: any configured provider key or
# SUPABASE_SERVICE_ROLE_KEY disables the demo signing endpoint and the
# datastore throws instead of falling back to demo.
# Demo-only webhook signing secret. OPTIONAL for local dev: when unset (or
# left at the placeholder), a random per-process secret is generated — the
# mock checkout flow still works through /api/demo/sign. Set an explicit
# value only if you run multiple demo-mode server processes that must share
# one secret. Ignored whenever a real provider or service key is configured.
DEMO_WEBHOOK_SECRET=

# ── Rate limiting (production) ──
# Shared fixed-window limiter over Upstash Redis REST. Required for
# multi-instance correctness on Vercel — without it, each serverless
# instance enforces its own in-memory counts. Create a database at
# https://console.upstash.com → Redis → REST API, then set both values in
# Production AND Preview (separate databases ideally). Local/demo/CI without
# these falls back to in-memory limits (single instance only).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── App ──
# Canonical public URL. OG cards and share links derive the host from this
# (defaults to priced.game in OG rendering when unset).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Monitoring — Sentry (optional, production) ──
# Server-side only. When set, payment-critical errors are also sent to Sentry
# (error-level logEvent). Leave empty until the owner wires the Log Drains
# destination + uptime checks per DEPLOY.md §8.
# SENTRY_DSN=

# ── Bot protection — Cloudflare Turnstile (optional, production) ──
# When the secret is set, /api/checkout fail-closed verifies a Turnstile token.
# Create a widget at https://dash.cloudflare.com → Turnstile (invisible mode).
# Leave both empty for demo/preview/CI — the check passes through.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ── Environment matrix (who sets what) ──
# Format: variable | local | preview | production | exposure
#
# NEXT_PUBLIC_SUPABASE_URL        | demo: unset | set (staging SB) | set (prod SB)  | public
# NEXT_PUBLIC_SUPABASE_ANON_KEY  | demo: unset | set (staging SB) | set (prod SB)  | public (RLS-bound)
# SUPABASE_SERVICE_ROLE_KEY      | unset       | STAGING ONLY      | prod           | SECRET server-only
# DODO_PAYMENTS_API_KEY           | unset       | TEST key only     | LIVE key       | SECRET server-only
# DODO_PAYMENTS_MODE              | unset       | test              | live           | config
# DODO_PAYMENTS_PRODUCT_ID       | unset       | test product      | live product   | config
# DODO_PAYMENTS_WEBHOOK_KEY       | unset       | TEST webhook key  | LIVE webhook key SECRET server-only
# UPSTASH_REDIS_REST_URL         | unset       | staging Redis     | prod Redis     | SECRET server-only
# UPSTASH_REDIS_REST_TOKEN       | unset       | staging token     | prod token     | SECRET server-only
# NEXT_PUBLIC_APP_URL             | localhost   | preview URL       | canonical host | public
# TURNSTILE_SECRET_KEY            | unset       | optional (test)   | set           | SECRET server-only
# NEXT_PUBLIC_TURNSTILE_SITE_KEY  | unset       | optional (test)   | set           | public
# SENTRY_DSN                      | unset       | optional          | optional      | server-only
# DEMO_WEBHOOK_SECRET             | optional   | unset (see note)  | NEVER         | server-only
# STRIPE_SECRET_KEY / _WEBHOOK_SECRET | unset | unset            | optional      | SECRET server-only
#
# Isolation rules (enforced by Vercel env scoping, verified by owner):
# 1. Never reuse a Production value for SUPABASE_*, DODO_*, or UPSTASH_* in
#    Preview. Preview gets its own Supabase project, its own Upstash DB, and
#    Dodo TEST credentials.
# 2. DEMO_* is incompatible with any configured provider/service key (the
#    app hard-disables demo payments then). Never set it in Production.
# 3. PRICED_CREDITS_ENABLED stays unset everywhere (credits feature OFF).
